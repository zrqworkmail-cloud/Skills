# workbuddy-video-generator · 环境变量样例
# 复制为 .env 或按需 export；值留空表示走 PATH / 库自带 / 运行时探测。
# 不要在此文件写入真实凭据，不要提交 .env。

# --- 外部二进制 ---
FFMPEG=
FFPROBE=
FFMPEG_PATH=
CHROME_PATH=              # 不设则 Puppeteer 使用自带 Chromium
PY=

# --- ComfyUI / AI 生成路线 ---
COMFY_OUTPUT_DIR=         # 默认 ~/ComfyUI/output/wan22
COMFY_WORKFLOW_TEMPLATE=  # 默认 workflow.api.json，需自行从 ComfyUI 导出

# --- 项目路由 ---
FILM=                     # 多片项目：决定 films/<FILM>/ 目标目录

# --- 自动同步脚本（可选，谨慎使用）---
GIT_NAME=
GIT_EMAIL=
