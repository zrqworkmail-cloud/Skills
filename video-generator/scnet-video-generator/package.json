{
  "name": "scnet-video-generator",
  "version": "1.0.0",
  "private": true,
  "description": "镜头驱动的视频制作流程包；此 package.json 仅用于类型检查与示例渲染，不影响技能本体",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:cards": "node scripts/check-recipes.mjs assets/cards",
    "studio": "remotion studio examples/minimal/src/index.ts",
    "render": "remotion render examples/minimal/src/index.ts Example out/example.mp4 --codec=h264 --crf=23 --pixel-format=yuv420p --image-format=png",
    "render:spot": "remotion render examples/minimal/src/index.ts Spot30 out/spot30.mp4 --codec=h264 --crf=20 --pixel-format=yuv420p --image-format=png"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.542",
    "@remotion/transitions": "^4.0.542",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.542"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
